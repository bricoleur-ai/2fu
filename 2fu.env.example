# 2fu settings. Copy this file to ~/.config/2fu/env (the systemd unit reads it), or set the
# variables in your shell (`set -a; . ~/.config/2fu/env; set +a` exports them all). Every line is
# optional; the values below are the defaults.

# Names allowed to fetch a code, comma-separated. A consumer asks for GET /code?client=<name>.
TWOFU_CLIENTS=my-client

# Port to listen on, on all interfaces.
TWOFU_PORT=8787

# Seconds an unfetched code lives.
TWOFU_TTL_SECONDS=300
